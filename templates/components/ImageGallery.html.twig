{# Default rendering of the `ImageGallery` component: delegates to the module's
   neutral markup (same template as the theme hook and the back-office preview). #}
{% if this.slides is not empty %}
    {% include '@ImageGalleryModule/theme-hook/image-gallery.html.twig' with {
        group: this.group,
        slides: this.slides,
        autoplay: this.autoplay,
    } only %}
{% endif %}
